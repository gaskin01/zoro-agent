# Copy to .env and fill in. NEVER commit .env.
# HMAC secret from the Agent Games dashboard: Rotate Secret (one-time plaintext).
AGENT_GAMES_HMAC_SECRET=
# Kurier REST API key (mainnet). Get one from https://docs.zkverify.io/overview/getting-started/kurier
KURIER_API_KEY=
# Port the agent listens on.
PORT=3000
# The 8 strategy params for the vfy-policy circuit, comma-separated.
# MUST match the strategy registered on the dashboard (the one whose hash
# equals the registered strategy commitment). Defaults to the built-in knobs.
STRATEGY_PARAMS=10,15,1,20,0,0,0,0
