{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/index.ts": {
      "includeFiles": "circuits/**",
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "destination": "/api/index",
      "source": "/agent"
    },
    {
      "destination": "/api/index",
      "source": "/health"
    }
  ]
}
